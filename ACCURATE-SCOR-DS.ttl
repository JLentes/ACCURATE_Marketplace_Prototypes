@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix accurate: <http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE-Indicators#> .
@prefix accurate-scor: <http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE-SCOR#> .

<http://accurate.de.iao.fraunhofer.de/ontologies/ACCURATE-SCOR-DS-KPI-Individuals-Complete>
 a owl:Ontology ;
 owl:versionInfo "1.2.0" ;
 dcterms:title "ACCURATE SCOR-DS KPI Ontology, KPI-as-NamedIndividual model"@en ;
 dcterms:source "accurate-scor-indicators-REDESIGN2_KPI_as_NamedIndividual - Kopie.txt" ;
 rdfs:comment "Self-contained ACCURATE SCOR-DS KPI catalogue using the KPI-as-NamedIndividual design. Labels, quantity kinds and recommended units are aligned with the supplied ACCURATE source catalogue where available; hierarchy, process, calculation and context semantics are retained. SHACL shapes are intentionally excluded."@en .

### Core indicator/value model
accurate:IndicatorType a owl:Class .
accurate:Indicator a owl:Class ; rdfs:subClassOf
 [ a owl:Restriction ; owl:onProperty accurate:hasIndicatorType ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass accurate:IndicatorType ] .
accurate:IndicatorValue a owl:Class ; rdfs:subClassOf qudt:QuantityValue .
accurate:MeasurementContext a owl:Class .
accurate:CalculationSpecification a owl:Class .
accurate:AggregationFunction a owl:Class .
accurate:OptimizationDirection a owl:Class .

accurate:hasIndicatorType a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain accurate:Indicator ; rdfs:range accurate:IndicatorType .
accurate:hasIndicatorValue a owl:ObjectProperty ; rdfs:domain accurate:Indicator ; rdfs:range accurate:IndicatorValue .
accurate:hasQuantityKind a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain accurate:IndicatorType ; rdfs:range qudt:QuantityKind .
accurate:hasRecommendedUnit a owl:ObjectProperty ; rdfs:domain accurate:IndicatorType ; rdfs:range qudt:Unit .
accurate:hasMeasurementContext a owl:ObjectProperty ; rdfs:domain accurate:Indicator ; rdfs:range accurate:MeasurementContext .
accurate:hasCalculationSpecification a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain accurate:IndicatorType ; rdfs:range accurate:CalculationSpecification .
accurate:hasAggregationFunction a owl:ObjectProperty ; rdfs:domain accurate:CalculationSpecification ; rdfs:range accurate:AggregationFunction .
accurate:hasNumeratorIndicatorType a owl:ObjectProperty ; rdfs:domain accurate:CalculationSpecification ; rdfs:range accurate:IndicatorType .
accurate:hasDenominatorIndicatorType a owl:ObjectProperty ; rdfs:domain accurate:CalculationSpecification ; rdfs:range accurate:IndicatorType .
accurate:hasPreferredDirection a owl:ObjectProperty ; rdfs:domain accurate:IndicatorType ; rdfs:range accurate:OptimizationDirection .
accurate:formulaExpression a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain accurate:CalculationSpecification ; rdfs:range xsd:string .
accurate:measurementStart a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain accurate:MeasurementContext ; rdfs:range xsd:dateTime .
accurate:measurementEnd a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain accurate:MeasurementContext ; rdfs:range xsd:dateTime .
accurate:forProduct a owl:ObjectProperty ; rdfs:domain accurate:MeasurementContext .
accurate:forService a owl:ObjectProperty ; rdfs:domain accurate:MeasurementContext .
accurate:forOrganization a owl:ObjectProperty ; rdfs:domain accurate:MeasurementContext .
accurate:forFacility a owl:ObjectProperty ; rdfs:domain accurate:MeasurementContext .

accurate:Sum a owl:NamedIndividual, accurate:AggregationFunction .
accurate:Average a owl:NamedIndividual, accurate:AggregationFunction .
accurate:Minimum a owl:NamedIndividual, accurate:AggregationFunction .
accurate:Maximum a owl:NamedIndividual, accurate:AggregationFunction .
accurate:HigherIsBetter a owl:NamedIndividual, accurate:OptimizationDirection .
accurate:LowerIsBetter a owl:NamedIndividual, accurate:OptimizationDirection .
accurate:TargetValueIsBest a owl:NamedIndividual, accurate:OptimizationDirection .

### SCOR hierarchy and process model
accurate-scor:SCORIndicatorType a owl:Class ; rdfs:subClassOf accurate:IndicatorType, skos:Concept ; owl:hasKey ( accurate-scor:scorCode ) .
accurate-scor:SCORReliabilityIndicatorType a owl:Class ; rdfs:subClassOf accurate-scor:SCORIndicatorType .
accurate-scor:SCORResponsivenessIndicatorType a owl:Class ; rdfs:subClassOf accurate-scor:SCORIndicatorType .
accurate-scor:SCORAgilityIndicatorType a owl:Class ; rdfs:subClassOf accurate-scor:SCORIndicatorType .
accurate-scor:SCORCostIndicatorType a owl:Class ; rdfs:subClassOf accurate-scor:SCORIndicatorType .
accurate-scor:SCORProfitIndicatorType a owl:Class ; rdfs:subClassOf accurate-scor:SCORIndicatorType .
accurate-scor:SCORAssetIndicatorType a owl:Class ; rdfs:subClassOf accurate-scor:SCORIndicatorType .
accurate-scor:SCOREnvironmentalIndicatorType a owl:Class ; rdfs:subClassOf accurate-scor:SCORIndicatorType .
accurate-scor:SCORSocietalIndicatorType a owl:Class ; rdfs:subClassOf accurate-scor:SCORIndicatorType .

accurate-scor:SCORProcess a owl:Class ; rdfs:subClassOf skos:Concept .
accurate-scor:SCORPerformanceAttribute a owl:Class ; rdfs:subClassOf skos:Concept .
accurate-scor:SCORIndicatorLevel a owl:Class ; rdfs:subClassOf skos:Concept .
accurate-scor:scorCode a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain accurate-scor:SCORIndicatorType ; rdfs:range xsd:string .
accurate-scor:scorLevel a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain accurate-scor:SCORIndicatorType ; rdfs:range xsd:positiveInteger .
accurate-scor:hasPerformanceAttribute a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain accurate-scor:SCORIndicatorType ; rdfs:range accurate-scor:SCORPerformanceAttribute .
accurate-scor:hasIndicatorLevel a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain accurate-scor:SCORIndicatorType ; rdfs:range accurate-scor:SCORIndicatorLevel .
accurate-scor:hasDirectDiagnosticIndicator a owl:ObjectProperty ; rdfs:domain accurate-scor:SCORIndicatorType ; rdfs:range accurate-scor:SCORIndicatorType ; rdfs:subPropertyOf accurate-scor:hasDiagnosticIndicator ; owl:inverseOf accurate-scor:isDirectDiagnosticIndicatorOf .
accurate-scor:isDirectDiagnosticIndicatorOf a owl:ObjectProperty ; rdfs:subPropertyOf accurate-scor:isDiagnosticIndicatorOf .
accurate-scor:hasDiagnosticIndicator a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:domain accurate-scor:SCORIndicatorType ; rdfs:range accurate-scor:SCORIndicatorType ; owl:inverseOf accurate-scor:isDiagnosticIndicatorOf .
accurate-scor:isDiagnosticIndicatorOf a owl:ObjectProperty, owl:TransitiveProperty .
accurate-scor:measuresProcess a owl:ObjectProperty ; rdfs:domain accurate-scor:SCORIndicatorType ; rdfs:range accurate-scor:SCORProcess .

accurate-scor:Orchestrate a owl:NamedIndividual, accurate-scor:SCORProcess ; skos:prefLabel "Orchestrate"@en .
accurate-scor:Plan a owl:NamedIndividual, accurate-scor:SCORProcess ; skos:prefLabel "Plan"@en .
accurate-scor:Order a owl:NamedIndividual, accurate-scor:SCORProcess ; skos:prefLabel "Order"@en .
accurate-scor:Source a owl:NamedIndividual, accurate-scor:SCORProcess ; skos:prefLabel "Source"@en .
accurate-scor:Transform a owl:NamedIndividual, accurate-scor:SCORProcess ; skos:prefLabel "Transform"@en .
accurate-scor:Fulfill a owl:NamedIndividual, accurate-scor:SCORProcess ; skos:prefLabel "Fulfill"@en .
accurate-scor:Return a owl:NamedIndividual, accurate-scor:SCORProcess ; skos:prefLabel "Return"@en .
accurate-scor:CrossProcess a owl:NamedIndividual, accurate-scor:SCORProcess ; skos:prefLabel "CrossProcess"@en .
accurate-scor:Level1 a owl:NamedIndividual, accurate-scor:SCORIndicatorLevel ; skos:notation "1" .
accurate-scor:Level2 a owl:NamedIndividual, accurate-scor:SCORIndicatorLevel ; skos:notation "2" .
accurate-scor:Level3 a owl:NamedIndividual, accurate-scor:SCORIndicatorLevel ; skos:notation "3" .
accurate-scor:RL_Attribute a owl:NamedIndividual, accurate-scor:SCORPerformanceAttribute ; skos:prefLabel "Reliability"@en .
accurate-scor:RS_Attribute a owl:NamedIndividual, accurate-scor:SCORPerformanceAttribute ; skos:prefLabel "Responsiveness"@en .
accurate-scor:AG_Attribute a owl:NamedIndividual, accurate-scor:SCORPerformanceAttribute ; skos:prefLabel "Agility"@en .
accurate-scor:CO_Attribute a owl:NamedIndividual, accurate-scor:SCORPerformanceAttribute ; skos:prefLabel "Cost"@en .
accurate-scor:PR_Attribute a owl:NamedIndividual, accurate-scor:SCORPerformanceAttribute ; skos:prefLabel "Profit"@en .
accurate-scor:AM_Attribute a owl:NamedIndividual, accurate-scor:SCORPerformanceAttribute ; skos:prefLabel "Asset Management"@en .
accurate-scor:EV_Attribute a owl:NamedIndividual, accurate-scor:SCORPerformanceAttribute ; skos:prefLabel "Environmental"@en .
accurate-scor:SC_Attribute a owl:NamedIndividual, accurate-scor:SCORPerformanceAttribute ; skos:prefLabel "Societal"@en .

[] a owl:AllDisjointClasses ; owl:members ( accurate:IndicatorType accurate:Indicator accurate:IndicatorValue accurate:MeasurementContext accurate:CalculationSpecification ) .
[] a owl:AllDisjointClasses ; owl:members ( accurate-scor:SCORReliabilityIndicatorType accurate-scor:SCORResponsivenessIndicatorType accurate-scor:SCORAgilityIndicatorType accurate-scor:SCORCostIndicatorType accurate-scor:SCORProfitIndicatorType accurate-scor:SCORAssetIndicatorType accurate-scor:SCOREnvironmentalIndicatorType accurate-scor:SCORSocietalIndicatorType ) .

accurate-scor:RL_1_1
    a owl:NamedIndividual, accurate-scor:SCORReliabilityIndicatorType ;
    skos:notation "RL.1.1" ;
    skos:prefLabel "SCOR-DS Indicator RL.1.1"@en ;
    rdfs:label "SCOR-DS Indicator RL.1.1"@en ;
    accurate-scor:scorCode "RL.1.1" ;
    accurate-scor:scorLevel 1 ;
    accurate-scor:hasIndicatorLevel accurate-scor:Level1 ;
    accurate-scor:hasPerformanceAttribute accurate-scor:RL_Attribute ;
    accurate-scor:measuresProcess accurate-scor:CrossProcess ;
    accurate:hasQuantityKind quantitykind:DimensionlessRatio ;
    accurate:hasRecommendedUnit unit:PERCENT .

